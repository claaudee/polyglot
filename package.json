{
  "name": "pclaude",
  "version": "0.1.0",
  "description": "Polyglot proxy for Claude Code: translates prompts to English and replies back",
  "type": "module",
  "bin": {
    "pclaude": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "test": "node --import tsx --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.310",
    "@clack/prompts": "^1.8.1",
    "cli-table3": "^0.6.5",
    "commander": "^15.0.0",
    "conf": "^16.0.0",
    "env-paths": "^4.0.0",
    "execa": "^10.2.1",
    "marked": "^18.1.1",
    "picocolors": "^1.1.1",
    "pino": "^10.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
